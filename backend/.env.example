# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# ── Servidor ──
PORT=4000
NODE_ENV=development
# Orígenes permitidos por CORS (lista separada por comas)
CORS_ORIGIN=http://localhost:5173

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cafeterito_database

# ── JWT ──
# Genera un secreto largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# RNF09: sesión de 10 minutos; el frontend la renueva con /api/auth/refresh mientras haya actividad
JWT_EXPIRES=10m

# ── Administrador inicial (npm run seed:admin) ──
# La contraseña debe cumplir RNF10: 10–64 caracteres, mayúscula, minúscula, número y símbolo.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Correo (recuperación de contraseña) ──
# Si SMTP_HOST está vacío y NODE_ENV != production, el código se imprime en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cafeterito <no-reply@cafeterito.local>"

# ── Rate limiting (/api/auth) ──
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_RESET_MAX=5
