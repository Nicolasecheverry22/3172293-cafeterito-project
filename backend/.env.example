# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# ── Servidor ──
PORT=4000

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cafeterito_database

# ── JWT ──
# Genera un secreto largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=1h

# ── Administrador inicial (npm run seed:admin) ──
# La contraseña debe cumplir RNF10: 10–64 caracteres, mayúscula, minúscula, número y símbolo.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
